# Room server + support worker (MeetProxy engine, presented as "CorgiPay Support")
PORT=8791
DATABASE_URL=postgres://meetproxy:meetproxy@localhost:5435/meetproxy   # or a Supabase pooler URL (TLS auto)
BASE_URL=https://corgipay.boilerroom.tech/support   # public base; its path becomes the route prefix
# BASE_PATH=/support                                 # set explicitly if BASE_URL is unset
ROOM_SERVICE_KEY=                                    # shared with CorgiPay so its 500s can open rooms
WORKER=1                                             # 0 = do not auto-start support-worker.mjs

# Support agent (Agent37 Cloud, Hermes). Without these the worker runs in MOCK mode.
AGENT37_API_KEY=
AGENT37_INSTANCE=
AGENT37_MODEL=openai/gpt-5                           # optional, routed by Agent37
MOCK=0

# What the support agent works on
CORGIPAY_PROD_URL=https://corgipay.boilerroom.tech
CORGIPAY_REPO_PATH=/home/node/corgipay
CORGIPAY_REPO_URL=https://github.com/Metroxe/corgipay.git
